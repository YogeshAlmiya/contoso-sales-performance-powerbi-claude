/// Calculation group: Current, MTD, QTD or YTD for any measure, up to the last date in context. Combine with Scenario, e.g. YTD + PY = last year's YTD.
table Time
	lineageTag: f8091df7-d498-4b20-823e-98302d880c3c

	/// Period-to-date variants applied to any measure, inside Scenario: PY + YTD = last year's YTD, ΔBU + YTD = year-to-date gap to budget.
	calculationGroup
		precedence: 10

		/// The period in the filter context, unchanged (the default).
		calculationItem Current = SELECTEDMEASURE ()

		/// Month to date, up to the last date in context. Combine with Scenario, e.g. MTD + ΔPY.
		calculationItem MTD = CALCULATE ( SELECTEDMEASURE (), DATESMTD ( 'Date'[Date] ) )

		/// Quarter to date, up to the last date in context. Combine with Scenario, e.g. QTD + ΔBU.
		calculationItem QTD = CALCULATE ( SELECTEDMEASURE (), DATESQTD ( 'Date'[Date] ) )

		/// Year to date, up to the last date in context. Combine with Scenario: YTD + PY = last year's YTD, YTD + ΔBU = YTD gap to budget.
		calculationItem YTD = CALCULATE ( SELECTEDMEASURE (), DATESYTD ( 'Date'[Date] ) )

	/// Pick a period for any measure: Current, MTD, QTD, YTD. Combine with Scenario: YTD + PY = last year's YTD, YTD + ΔBU = YTD gap to budget.
	column Time
		dataType: string
		lineageTag: d5751c9f-e114-4d6a-bb0f-6be04342e460
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

	/// Technical: display order of the time items.
	column Ordinal
		dataType: int64
		isHidden
		lineageTag: 853dfb46-7c95-41f6-ac41-4cda4262d9d1
		summarizeBy: none
		sourceColumn: Ordinal

	partition Partition_Time = calculationGroup

