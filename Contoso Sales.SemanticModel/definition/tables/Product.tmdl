/// Products (items) with brand, subcategory and category. BU and FC exist only by category; they are blank by subcategory, brand or product.
table Product
	lineageTag: 229433ce-36da-4288-b062-6581152a59df

	/// Technical: product key joining Sales; key of the Product table.
	column 'Product Key'
		dataType: int64
		isHidden
		isKey
		lineageTag: 26207bc4-2f78-4527-8a4a-5c3713507a5a
		summarizeBy: none
		sourceColumn: ProductKey

	/// Product (item) name; label of the Product table. BU and FC are blank by product.
	column 'Product Name'
		dataType: string
		isDefaultLabel
		lineageTag: 8ea45412-9c31-4887-8697-dfa92015fd58
		summarizeBy: none
		sourceColumn: ProductName

	/// Brand (manufacturer) of the product. BU and FC are blank by brand.
	column Brand
		dataType: string
		lineageTag: f4884716-dfd8-499f-b560-ca94cb19b129
		summarizeBy: none
		sourceColumn: Brand

	/// Product subcategory. BU and FC are blank by subcategory; use Category for plan comparisons.
	column Subcategory
		dataType: string
		lineageTag: 4d077d6b-915c-4a52-aa7d-2e7fcc1b4e25
		summarizeBy: none
		sourceColumn: Subcategory

	/// Product category (8 categories, e.g. Computers), the level at which budget (BU) and forecast (FC) are set.
	column Category
		dataType: string
		lineageTag: 7f9403e8-2754-49bf-8c5d-a744b171f58a
		summarizeBy: none
		sourceColumn: Category

	/// Technical: category key joining the Plan.
	column 'Category Key'
		dataType: int64
		isHidden
		lineageTag: 4fbe3c0d-ec62-486a-bd53-6b88fe5505ad
		summarizeBy: none
		sourceColumn: CategoryKey

	/// Category > Subcategory > Product. The plan shows at category level only.
	hierarchy 'Product Hierarchy'
		lineageTag: 03ae3e20-9260-4f86-b0f6-70e9cf69823c

		level Category
			lineageTag: 9e564eee-a100-4755-b128-9f781f5f48ff
			column: Category

		level Subcategory
			lineageTag: e72fd06f-7a64-48f7-809e-26e4b233a7fd
			column: Subcategory

		level Product
			lineageTag: e5ff386e-ab20-467c-8f68-4b4dcd33e19d
			column: 'Product Name'

	partition Product = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    View = Source{[Schema = "model", Item = "DimProduct"]}[Data]
				in
				    View

	annotation PBI_ResultType = Table

