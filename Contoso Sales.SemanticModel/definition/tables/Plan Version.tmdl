/// Plan versions (IBCS scenarios): BU = Budget, FC = Forecast (Jan-Jun actuals, Jul-Dec reforecast). Hidden: the Scenario calculation group selects versions. Source: view model.PlanVersion.
table 'Plan Version'
	isHidden
	lineageTag: 55a5f6d4-02ed-4b6a-8251-ea8eda31d878

	/// Plan version identifier.
	column 'Plan Version Key'
		dataType: int64
		isHidden
		lineageTag: b49ff169-af7c-410e-b3cd-08b5e9373711
		summarizeBy: none
		sourceColumn: PlanVersionKey

	/// IBCS scenario code, BU or FC.
	column Scenario
