	column 'Scenario Name'
		dataType: string
		lineageTag: 0eae8c08-1385-4403-91f2-d0d0bc68c873
		summarizeBy: none
		sourceColumn: ScenarioName
		sortByColumn: 'Sort Order'

	/// IBCS scenario order: AC 1, PY 2, BU 3, FC 4.
	column 'Sort Order'
