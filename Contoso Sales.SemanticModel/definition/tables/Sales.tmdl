	/// Report only: SVG KPI tile for the Overview, 376 x 132 px: AC sales in USD m, the variance vs the chosen comparison and the second comparison, and mini IBCS bars for AC and both comparisons.
	measure 'KPI Sales SVG' =
			VAR _year = MAX ( 'Date'[Year] )
			VAR _actual = [AC]
			VAR _code1 = [Comparison Label]
			VAR _code2 = [CMP2 Label]
			VAR _value1 = [CMP]
			VAR _value2 = [CMP2]
			VAR _scale = DIVIDE ( 100, MAX ( MAX ( _actual, _value1 ), _value2 ) )
			VAR _style1 =
			    SWITCH (
			        _code1,
			        "PY", "fill='%23A6A6A6'",
			        "FC", "fill='url(%23h)' stroke='%231F1F1F' stroke-width='1.2'",
			        "fill='white' stroke='%231F1F1F' stroke-width='1.2'"
			    )
			VAR _style2 = IF ( _code2 = "PY", "fill='%23A6A6A6'", "fill='white' stroke='%231F1F1F' stroke-width='1.2'" )
			-- One variance row; YY is replaced by the row's baseline
			VAR _row1 =
			    "<text x='16' y='YY' class='k b'>&%23916;" & _code1 & "</text>"
			        & IF (
			            ISBLANK ( [ΔCMP] ),
			            "<text x='64' y='YY' class='k'>&%238211;</text>",
			            "<text x='64' y='YY' class='v " & IF ( [ΔCMP] < 0, "r", "g" ) & "'>" & FORMAT ( ROUND ( [ΔCMP] / 1e6, 1 ), "+0.0;-0.0;0.0" ) & "</text>"
			                & "<text x='124' y='YY' class='v " & IF ( [ΔCMP %] < 0, "r", "g" ) & "'>" & SUBSTITUTE ( FORMAT ( [ΔCMP %], "+0.0%;-0.0%;0.0%" ), "%", "%25" ) & "</text>"
			        )
			VAR _row2 =
			    "<text x='16' y='YY' class='k b'>&%23916;" & _code2 & "</text>"
			        & IF (
			            ISBLANK ( [ΔCMP2] ),
			            "<text x='64' y='YY' class='k'>&%238211;</text>",
			            "<text x='64' y='YY' class='v " & IF ( [ΔCMP2] < 0, "r", "g" ) & "'>" & FORMAT ( ROUND ( [ΔCMP2] / 1e6, 1 ), "+0.0;-0.0;0.0" ) & "</text>"
			                & "<text x='124' y='YY' class='v " & IF ( [ΔCMP2 %] < 0, "r", "g" ) & "'>" & SUBSTITUTE ( FORMAT ( [ΔCMP2 %], "+0.0%;-0.0%;0.0%" ), "%", "%25" ) & "</text>"
			        )
			VAR _bars =
			    "<text x='232' y='35' class='s'>AC</text><rect x='256' y='25' width='" & FORMAT ( _actual * _scale, "0.0" ) & "' height='12' fill='%231F1F1F'/>"
			        & "<text x='232' y='59' class='s'>" & _code1 & "</text>"
			        & IF ( NOT ISBLANK ( _value1 ), "<rect x='256.6' y='49.6' width='" & FORMAT ( MAX ( _value1 * _scale - 1.2, 0 ), "0.0" ) & "' height='10.8' " & _style1 & "/>" )
			        & "<text x='232' y='83' class='s'>" & _code2 & "</text>"
			        & IF ( NOT ISBLANK ( _value2 ), "<rect x='256.6' y='73.6' width='" & FORMAT ( MAX ( _value2 * _scale - 1.2, 0 ), "0.0" ) & "' height='10.8' " & _style2 & "/>" )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='376' height='132' viewBox='0 0 376 132'>"
			        & "<style>text{font-family:Segoe UI,sans-serif;fill:%231A1A1A}.k{font-size:14px;fill:%236B7280}.b{font-weight:600}.n{font-size:34px;font-weight:600}"
			        & ".v{font-size:14px;font-weight:600}.s{font-size:12px;fill:%236B7280}.g{fill:%233F8A54}.r{fill:%23B83A3A}</style>"
			        & "<defs><pattern id='h' width='5' height='5' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>"
			        & "<rect width='5' height='5' fill='white'/><line x1='0' y1='0' x2='0' y2='5' stroke='%231F1F1F' stroke-width='1.6'/></pattern></defs>"
			        & "<text x='16' y='26' class='k'>Sales &%23183; AC " & _year & " &%23183; USD m</text>"
			        & "<text x='16' y='70' class='n'>" & FORMAT ( _actual / 1e6, "0.0" ) & "</text>"
			        & SUBSTITUTE ( _row1, "YY", "100" ) & SUBSTITUTE ( _row2, "YY", "122" ) & _bars
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _actual ), "data:image/svg+xml;utf8," & _svg )
		displayFolder: Report visuals
		isHidden
		lineageTag: a3a25208-c83e-4d5c-8124-c3a4075ecd24
		dataCategory: ImageUrl

	/// Report only: SVG KPI tile for the Overview, 376 x 132 px: AC gross margin in USD m vs last year, a note that there is no margin budget, and mini IBCS bars for AC and PY.
	measure 'KPI Margin SVG' =
			VAR _year = MAX ( 'Date'[Year] )
			VAR _actual = [Gross Margin]
			VAR _previous = [Gross Margin PY]
			VAR _delta = [Gross Margin ΔPY]
			VAR _pct = [Gross Margin ΔPY %]
			VAR _code1 = [Comparison Label]
			VAR _plan = IF ( _code1 = "PY", "BU", _code1 )
			VAR _scale = DIVIDE ( 100, MAX ( _actual, _previous ) )
			VAR _pyRow =
			    "<text x='16' y='YY' class='k b'>&%23916;PY</text>"
			        & IF (
			            ISBLANK ( _delta ),
			            "<text x='64' y='YY' class='k'>&%238211;</text>",
			            "<text x='64' y='YY' class='v " & IF ( _delta < 0, "r", "g" ) & "'>" & FORMAT ( ROUND ( _delta / 1e6, 1 ), "+0.0;-0.0;0.0" ) & "</text>"
			                & "<text x='124' y='YY' class='v " & IF ( _pct < 0, "r", "g" ) & "'>" & SUBSTITUTE ( FORMAT ( _pct, "+0.0%;-0.0%;0.0%" ), "%", "%25" ) & "</text>"
			        )
			VAR _planRow =
			    "<text x='16' y='YY' class='k b'>&%23916;" & _plan & "</text>"
			        & "<text x='64' y='YY' class='s'>&%238211;  no margin " & IF ( _plan = "FC", "forecast", "budget" ) & "</text>"
			VAR _rows =
			    IF (
			        _code1 = "PY",
			        SUBSTITUTE ( _pyRow, "YY", "100" ) & SUBSTITUTE ( _planRow, "YY", "122" ),
			        SUBSTITUTE ( _planRow, "YY", "100" ) & SUBSTITUTE ( _pyRow, "YY", "122" )
			    )
			VAR _bars =
			    "<text x='232' y='35' class='s'>AC</text><rect x='256' y='25' width='" & FORMAT ( _actual * _scale, "0.0" ) & "' height='12' fill='%231F1F1F'/>"
			        & "<text x='232' y='59' class='s'>PY</text>"
			        & IF ( NOT ISBLANK ( _previous ), "<rect x='256' y='49' width='" & FORMAT ( _previous * _scale, "0.0" ) & "' height='12' fill='%23A6A6A6'/>" )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='376' height='132' viewBox='0 0 376 132'>"
			        & "<style>text{font-family:Segoe UI,sans-serif;fill:%231A1A1A}.k{font-size:14px;fill:%236B7280}.b{font-weight:600}.n{font-size:34px;font-weight:600}"
			        & ".v{font-size:14px;font-weight:600}.s{font-size:12px;fill:%236B7280}.g{fill:%233F8A54}.r{fill:%23B83A3A}</style>"
			        & "<text x='16' y='26' class='k'>Margin &%23183; AC " & _year & " &%23183; USD m</text>"
			        & "<text x='16' y='70' class='n'>" & FORMAT ( _actual / 1e6, "0.0" ) & "</text>"
			        & _rows & _bars
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _actual ), "data:image/svg+xml;utf8," & _svg )
		displayFolder: Report visuals
		isHidden
		lineageTag: f20ee19f-0dd8-4f93-9f5a-c543b4806acd
		dataCategory: ImageUrl

	/// Report only: SVG KPI tile for the Overview, 376 x 132 px: AC gross margin rate vs last year in pp, a note that there is no margin budget, and mini IBCS bars for AC and PY.
	measure 'KPI Margin % SVG' =
			VAR _year = MAX ( 'Date'[Year] )
			VAR _actual = [Gross Margin %]
			VAR _previous = [Gross Margin % PY]
			VAR _pp = [Gross Margin % ΔPY pp]
			VAR _code1 = [Comparison Label]
			VAR _plan = IF ( _code1 = "PY", "BU", _code1 )
			VAR _scale = DIVIDE ( 100, MAX ( _actual, _previous ) )
			VAR _pyRow =
			    "<text x='16' y='YY' class='k b'>&%23916;PY</text>"
			        & IF (
			            ISBLANK ( _pp ),
			            "<text x='64' y='YY' class='k'>&%238211;</text>",
			            "<text x='64' y='YY' class='v " & IF ( _pp < 0, "r", "g" ) & "'>" & FORMAT ( ROUND ( _pp, 1 ), "+0.0;-0.0;0.0" ) & " pp</text>"
			        )
			VAR _planRow =
			    "<text x='16' y='YY' class='k b'>&%23916;" & _plan & "</text>"
			        & "<text x='64' y='YY' class='s'>&%238211;  no margin " & IF ( _plan = "FC", "forecast", "budget" ) & "</text>"
			VAR _rows =
			    IF (
			        _code1 = "PY",
			        SUBSTITUTE ( _pyRow, "YY", "100" ) & SUBSTITUTE ( _planRow, "YY", "122" ),
			        SUBSTITUTE ( _planRow, "YY", "100" ) & SUBSTITUTE ( _pyRow, "YY", "122" )
			    )
			VAR _bars =
			    "<text x='232' y='35' class='s'>AC</text><rect x='256' y='25' width='" & FORMAT ( _actual * _scale, "0.0" ) & "' height='12' fill='%231F1F1F'/>"
			        & "<text x='232' y='59' class='s'>PY</text>"
			        & IF ( NOT ISBLANK ( _previous ), "<rect x='256' y='49' width='" & FORMAT ( _previous * _scale, "0.0" ) & "' height='12' fill='%23A6A6A6'/>" )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='376' height='132' viewBox='0 0 376 132'>"
			        & "<style>text{font-family:Segoe UI,sans-serif;fill:%231A1A1A}.k{font-size:14px;fill:%236B7280}.b{font-weight:600}.n{font-size:34px;font-weight:600}"
			        & ".v{font-size:14px;font-weight:600}.s{font-size:12px;fill:%236B7280}.g{fill:%233F8A54}.r{fill:%23B83A3A}</style>"
			        & "<text x='16' y='26' class='k'>Margin %25 &%23183; AC " & _year & "</text>"
			        & "<text x='16' y='70' class='n'>" & SUBSTITUTE ( FORMAT ( _actual, "0.0%" ), "%", "%25" ) & "</text>"
			        & _rows & _bars
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _actual ), "data:image/svg+xml;utf8," & _svg )
		displayFolder: Report visuals
		isHidden
		lineageTag: 4bf6682f-450a-4fd9-893d-73ce8231c756
		dataCategory: ImageUrl

	/// Report only: SVG KPI tile for the Overview, 376 x 132 px: the full-year forecast FC 6+6 in USD m vs budget and last year, with mini IBCS bars for FC (hatched), BU (outlined) and PY (grey).
	measure 'KPI FC SVG' =
			VAR _forecast = [FC]
			VAR _budget = [BU]
			VAR _previous = [PY]
			VAR _deltaBU = IF ( NOT ISBLANK ( _forecast ) && NOT ISBLANK ( _budget ), _forecast - _budget )
			VAR _deltaPY = IF ( NOT ISBLANK ( _forecast ) && NOT ISBLANK ( _previous ), _forecast - _previous )
			VAR _pctBU = DIVIDE ( _deltaBU, _budget )
			VAR _pctPY = DIVIDE ( _deltaPY, _previous )
			VAR _scale = DIVIDE ( 100, MAX ( MAX ( _forecast, _budget ), _previous ) )
			VAR _row =
			    "<text x='16' y='YY' class='k b'>&%23916;CODE</text>"
			        & "<text x='64' y='YY' class='v SIGN1'>DELTA</text><text x='124' y='YY' class='v SIGN2'>PCT</text>"
			VAR _rowBU =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _row,
			        "YY", "100" ), "CODE", "BU" ), "SIGN1", IF ( _deltaBU < 0, "r", "g" ) ), "SIGN2", IF ( _pctBU < 0, "r", "g" ) ),
			        "DELTA", FORMAT ( ROUND ( _deltaBU / 1e6, 1 ), "+0.0;-0.0;0.0" ) ), "PCT", SUBSTITUTE ( FORMAT ( _pctBU, "+0.0%;-0.0%;0.0%" ), "%", "%25" ) )
			VAR _rowPY =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _row,
			        "YY", "122" ), "CODE", "PY" ), "SIGN1", IF ( _deltaPY < 0, "r", "g" ) ), "SIGN2", IF ( _pctPY < 0, "r", "g" ) ),
			        "DELTA", FORMAT ( ROUND ( _deltaPY / 1e6, 1 ), "+0.0;-0.0;0.0" ) ), "PCT", SUBSTITUTE ( FORMAT ( _pctPY, "+0.0%;-0.0%;0.0%" ), "%", "%25" ) )
			VAR _bars =
			    "<text x='232' y='35' class='s'>FC</text><rect x='256.6' y='25.6' width='" & FORMAT ( MAX ( _forecast * _scale - 1.2, 0 ), "0.0" ) & "' height='10.8' fill='url(%23h)' stroke='%231F1F1F' stroke-width='1.2'/>"
			        & "<text x='232' y='59' class='s'>BU</text>"
			        & IF ( NOT ISBLANK ( _budget ), "<rect x='256.6' y='49.6' width='" & FORMAT ( MAX ( _budget * _scale - 1.2, 0 ), "0.0" ) & "' height='10.8' fill='white' stroke='%231F1F1F' stroke-width='1.2'/>" )
			        & "<text x='232' y='83' class='s'>PY</text>"
			        & IF ( NOT ISBLANK ( _previous ), "<rect x='256' y='73' width='" & FORMAT ( _previous * _scale, "0.0" ) & "' height='12' fill='%23A6A6A6'/>" )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='376' height='132' viewBox='0 0 376 132'>"
			        & "<style>text{font-family:Segoe UI,sans-serif;fill:%231A1A1A}.k{font-size:14px;fill:%236B7280}.b{font-weight:600}.n{font-size:34px;font-weight:600}"
			        & ".v{font-size:14px;font-weight:600}.s{font-size:12px;fill:%236B7280}.g{fill:%233F8A54}.r{fill:%23B83A3A}</style>"
			        & "<defs><pattern id='h' width='5' height='5' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>"
			        & "<rect width='5' height='5' fill='white'/><line x1='0' y1='0' x2='0' y2='5' stroke='%231F1F1F' stroke-width='1.6'/></pattern></defs>"
			        & "<text x='16' y='26' class='k'>Sales &%23183; FC 6+6 full year &%23183; USD m</text>"
			        & "<text x='16' y='70' class='n'>" & FORMAT ( _forecast / 1e6, "0.0" ) & "</text>"
			        & IF ( NOT ISBLANK ( _deltaBU ), _rowBU ) & IF ( NOT ISBLANK ( _deltaPY ), _rowPY ) & _bars
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _forecast ), "data:image/svg+xml;utf8," & _svg )
		displayFolder: Report visuals
		isHidden
		lineageTag: b6f114b7-5e24-4e07-bd68-dafcf478e3ed
		dataCategory: ImageUrl

	/// Report only: SVG hero chart for the Overview, 1000 x 768 px: sales by month with IBCS overlapping columns (PY grey behind on the left, BU outlined or FC hatched behind on the right, AC in front, AC...
	measure 'Monthly Hero SVG' =
			VAR _code = [Comparison Label]
			VAR _plan = IF ( _code = "FC", "FC", "BU" )
			VAR _year = MAX ( 'Date'[Year] )
			VAR _months =
			    ADDCOLUMNS (
			        CALCULATETABLE ( SUMMARIZE ( 'Date', 'Date'[Year Month Key], 'Date'[Month Number], 'Date'[Month] ), 'Date'[Year] = _year ),
			        "@actual", [AC],
			        "@previous", [PY],
			        "@plan", IF ( _plan = "FC", [FC], [BU] ),
			        "@delta", [ΔCMP]
			    )
			-- Columns stand on y = 520 and are at most 360 px tall
			VAR _max = MAXX ( _months, MAX ( MAX ( [@actual], [@previous] ), [@plan] ) )
			VAR _scale = DIVIDE ( 360, _max )
			-- Variance strip: zero line between y = 602 and 722, placed by the positive/negative extent
			VAR _up = MAX ( MAXX ( _months, [@delta] ), 0 )
			VAR _down = MAX ( - MINX ( _months, [@delta] ), 0 )
			VAR _zero = 602 + IF ( _up + _down = 0, 60, 120 * _up / ( _up + _down ) )
			VAR _vScale = DIVIDE ( 120, _up + _down )
			VAR _planStyle =
			    IF (
			        _plan = "FC",
			        "fill='url(%23h)' stroke='%231F1F1F' stroke-width='1.2'",
			        "fill='white' stroke='%231F1F1F' stroke-width='1.2'"
			    )
			VAR _marks =
			    CONCATENATEX (
			        _months,
			        VAR _x = 72 + ( 'Date'[Month Number] - 1 ) * 76
			        VAR _hActual = [@actual] * _scale
			        VAR _hPrevious = [@previous] * _scale
			        VAR _hPlan = [@plan] * _scale
			        VAR _top = MAX ( MAX ( _hActual, _hPrevious ), _hPlan )
			        VAR _delta = [@delta]
			        VAR _hDelta = ABS ( _delta ) * _vScale
			        RETURN
			            -- IBCS overlapping columns: PY behind on the left, the plan behind on the right, AC in front
			            IF ( NOT ISBLANK ( [@previous] ), "<rect x='" & ( _x + 8 ) & "' y='" & FORMAT ( 520 - _hPrevious, "0.0" ) & "' width='30' height='" & FORMAT ( _hPrevious, "0.0" ) & "' fill='%23A6A6A6'/>" )
			            & IF ( NOT ISBLANK ( [@plan] ), "<rect x='" & FORMAT ( _x + 34.6, "0.0" ) & "' y='" & FORMAT ( 520.6 - _hPlan, "0.0" ) & "' width='28.8' height='" & FORMAT ( MAX ( _hPlan - 1.2, 0 ), "0.0" ) & "' " & _planStyle & "/>" )
			            & IF (
			                NOT ISBLANK ( [@actual] ),
			                "<rect x='" & ( _x + 21 ) & "' y='" & FORMAT ( 520 - _hActual, "0.0" ) & "' width='30' height='" & FORMAT ( _hActual, "0.0" ) & "' fill='%231F1F1F'/>"
			                    & "<text x='" & ( _x + 36 ) & "' y='" & FORMAT ( 512 - _top, "0.0" ) & "' class='v' text-anchor='middle'>" & FORMAT ( [@actual] / 1e6, "0.0" ) & "</text>"
			            )
			            & "<text x='" & ( _x + 36 ) & "' y='544' class='k' text-anchor='middle'>" & 'Date'[Month] & "</text>"
			            & IF (
			                ABS ( _delta ) >= 50000,
			                "<rect x='" & ( _x + 21 ) & "' y='" & FORMAT ( IF ( _delta > 0, _zero - _hDelta, _zero ), "0.0" ) & "' width='30' height='" & FORMAT ( _hDelta, "0.0" ) & "' fill='" & IF ( _delta < 0, "%23B83A3A", "%233F8A54" ) & "'/>"
			                    & "<text x='" & ( _x + 36 ) & "' y='" & FORMAT ( IF ( _delta > 0, _zero - _hDelta - 6, _zero + _hDelta + 16 ), "0.0" ) & "' class='v " & IF ( _delta < 0, "r", "g" ) & "' text-anchor='middle'>"
			                    & FORMAT ( ROUND ( _delta / 1e6, 1 ), "+0.0;-0.0;0.0" ) & "</text>"
			            ),
			        "",
			        'Date'[Year Month Key], ASC
			    )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1000' height='768' viewBox='0 0 1000 768'>"
			        & "<style>text{font-family:Segoe UI,sans-serif;fill:%231A1A1A}.t{font-size:16px;font-weight:600}.k{font-size:14px;fill:%236B7280}.b{font-weight:600}"
			        & ".v{font-size:13px;font-weight:600}.g{fill:%233F8A54}.r{fill:%23B83A3A}</style>"
			        & "<defs><pattern id='h' width='6' height='6' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>"
			        & "<rect width='6' height='6' fill='white'/><line x1='0' y1='0' x2='0' y2='6' stroke='%231F1F1F' stroke-width='2'/></pattern></defs>"
			        & "<text x='20' y='30' class='t'>" & [Headline Subject] & " | USD m | AC vs " & _plan & " and PY | " & _year & " by month</text>"
			        & "<rect x='20' y='50' width='14' height='14' fill='%231F1F1F'/><text x='40' y='62' class='k'>AC</text>"
			        & "<rect x='80.6' y='50.6' width='12.8' height='12.8' " & _planStyle & "/><text x='100' y='62' class='k'>" & _plan & "</text>"
			        & "<rect x='140' y='50' width='14' height='14' fill='%23A6A6A6'/><text x='160' y='62' class='k'>PY</text>"
			        & "<line x1='72' x2='984' y1='520' y2='520' stroke='%239CA3AF'/>"
			        & "<text x='20' y='" & FORMAT ( _zero + 5, "0.0" ) & "' class='k b'>&%23916;" & _code & "</text>"
			        & "<line x1='72' x2='984' y1='" & FORMAT ( _zero, "0.0" ) & "' y2='" & FORMAT ( _zero, "0.0" ) & "' stroke='%239CA3AF'/>"
			        & _marks
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _max ), "data:image/svg+xml;utf8," & _svg )
		displayFolder: Report visuals
		isHidden
		lineageTag: d13da117-338b-467a-bb85-9d9772e5739b
		dataCategory: ImageUrl

	/// Report only: SVG chart for the Channels page, 1000 x 520 px: the focus channel's sales by month (the clicked or selected channel, otherwise the one that contributes most to the variance) with IBCS...
	measure 'Focus Channel Monthly SVG' =
			VAR _channel = [Focus Channel]
			RETURN
			    CALCULATE (
			        VAR _code = [Comparison Label]
			        VAR _plan = IF ( _code = "FC", "FC", "BU" )
			        VAR _year = MAX ( 'Date'[Year] )
			        VAR _months =
			            ADDCOLUMNS (
			                CALCULATETABLE ( SUMMARIZE ( 'Date', 'Date'[Year Month Key], 'Date'[Month Number], 'Date'[Month] ), 'Date'[Year] = _year ),
			                "@actual", [AC],
			                "@previous", [PY],
			                "@plan", IF ( _plan = "FC", [FC], [BU] ),
			                "@delta", [ΔCMP]
			            )
			        -- Columns stand on y = 316 and are at most 200 px tall
			        VAR _max = MAXX ( _months, MAX ( MAX ( [@actual], [@previous] ), [@plan] ) )
			        VAR _scale = DIVIDE ( 200, _max )
			        -- Variance strip: zero line between y = 372 and 464
			        VAR _up = MAX ( MAXX ( _months, [@delta] ), 0 )
			        VAR _down = MAX ( - MINX ( _months, [@delta] ), 0 )
			        VAR _zero = 372 + IF ( _up + _down = 0, 46, 92 * _up / ( _up + _down ) )
			        VAR _vScale = DIVIDE ( 92, _up + _down )
			        VAR _planStyle =
			            IF (
			                _plan = "FC",
			                "fill='url(%23h)' stroke='%231F1F1F' stroke-width='1.2'",
			                "fill='white' stroke='%231F1F1F' stroke-width='1.2'"
			            )
			        VAR _marks =
			            CONCATENATEX (
			                _months,
			                VAR _x = 72 + ( 'Date'[Month Number] - 1 ) * 76
			                VAR _hActual = [@actual] * _scale
			                VAR _hPrevious = [@previous] * _scale
			                VAR _hPlan = [@plan] * _scale
			                VAR _top = MAX ( MAX ( _hActual, _hPrevious ), _hPlan )
			                VAR _delta = [@delta]
			                VAR _hDelta = ABS ( _delta ) * _vScale
			                RETURN
			                    IF ( NOT ISBLANK ( [@previous] ), "<rect x='" & ( _x + 8 ) & "' y='" & FORMAT ( 316 - _hPrevious, "0.0" ) & "' width='30' height='" & FORMAT ( _hPrevious, "0.0" ) & "' fill='%23A6A6A6'/>" )
			                    & IF ( NOT ISBLANK ( [@plan] ), "<rect x='" & FORMAT ( _x + 34.6, "0.0" ) & "' y='" & FORMAT ( 316.6 - _hPlan, "0.0" ) & "' width='28.8' height='" & FORMAT ( MAX ( _hPlan - 1.2, 0 ), "0.0" ) & "' " & _planStyle & "/>" )
			                    & IF (
			                        NOT ISBLANK ( [@actual] ),
			                        "<rect x='" & ( _x + 21 ) & "' y='" & FORMAT ( 316 - _hActual, "0.0" ) & "' width='30' height='" & FORMAT ( _hActual, "0.0" ) & "' fill='%231F1F1F'/>"
			                            & "<text x='" & ( _x + 36 ) & "' y='" & FORMAT ( 308 - _top, "0.0" ) & "' class='v' text-anchor='middle'>" & FORMAT ( [@actual] / 1e6, "0.0" ) & "</text>"
			                    )
			                    & "<text x='" & ( _x + 36 ) & "' y='340' class='k' text-anchor='middle'>" & 'Date'[Month] & "</text>"
			                    & IF (
			                        ABS ( _delta ) >= 50000,
			                        "<rect x='" & ( _x + 21 ) & "' y='" & FORMAT ( IF ( _delta > 0, _zero - _hDelta, _zero ), "0.0" ) & "' width='30' height='" & FORMAT ( _hDelta, "0.0" ) & "' fill='" & IF ( _delta < 0, "%23B83A3A", "%233F8A54" ) & "'/>"
			                            & "<text x='" & ( _x + 36 ) & "' y='" & FORMAT ( IF ( _delta > 0, _zero - _hDelta - 6, _zero + _hDelta + 16 ), "0.0" ) & "' class='v " & IF ( _delta < 0, "r", "g" ) & "' text-anchor='middle'>"
			                            & FORMAT ( ROUND ( _delta / 1e6, 1 ), "+0.0;-0.0;0.0" ) & "</text>"
			                    ),
			                "",
			                'Date'[Year Month Key], ASC
			            )
			        VAR _svg =
			            "<svg xmlns='http://www.w3.org/2000/svg' width='1000' height='520' viewBox='0 0 1000 520'>"
			                & "<style>text{font-family:Segoe UI,sans-serif;fill:%231A1A1A}.t{font-size:16px;font-weight:600}.k{font-size:14px;fill:%236B7280}.b{font-weight:600}"
			                & ".v{font-size:13px;font-weight:600}.g{fill:%233F8A54}.r{fill:%23B83A3A}</style>"
			                & "<defs><pattern id='h' width='6' height='6' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>"
			                & "<rect width='6' height='6' fill='white'/><line x1='0' y1='0' x2='0' y2='6' stroke='%231F1F1F' stroke-width='2'/></pattern></defs>"
			                & "<text x='20' y='30' class='t'>" & IF ( _channel = "Stores", "Store", _channel ) & " sales | USD m | AC vs " & _plan & " and PY | " & _year & " by month</text>"
			                & "<rect x='20' y='50' width='14' height='14' fill='%231F1F1F'/><text x='40' y='62' class='k'>AC</text>"
			                & "<rect x='80.6' y='50.6' width='12.8' height='12.8' " & _planStyle & "/><text x='100' y='62' class='k'>" & _plan & "</text>"
			                & "<rect x='140' y='50' width='14' height='14' fill='%23A6A6A6'/><text x='160' y='62' class='k'>PY</text>"
			                & "<line x1='72' x2='984' y1='316' y2='316' stroke='%239CA3AF'/>"
			                & "<text x='20' y='" & FORMAT ( _zero + 5, "0.0" ) & "' class='k b'>&%23916;" & _code & "</text>"
			                & "<line x1='72' x2='984' y1='" & FORMAT ( _zero, "0.0" ) & "' y2='" & FORMAT ( _zero, "0.0" ) & "' stroke='%239CA3AF'/>"
			                & _marks
			                & "</svg>"
			        RETURN
			            IF ( NOT ISBLANK ( _max ), "data:image/svg+xml;utf8," & _svg ),
			        'Store'[Channel] = _channel
			    )
		displayFolder: Report visuals
		isHidden
		lineageTag: 11b9550e-bde2-4f3c-8f31-663a8b3f4216
		dataCategory: ImageUrl

	/// Report only: SVG chart for the Outlook page, 1000 x 924 px: sales by month with PY grey behind, the June forecast FC 6+6 hatched behind for Jul-Dec, AC in front, and a strip of AC minus FC variance...
	measure 'Outlook Monthly SVG' =
			VAR _year = MAX ( 'Date'[Year] )
			VAR _months =
			    ADDCOLUMNS (
			        CALCULATETABLE ( SUMMARIZE ( 'Date', 'Date'[Year Month Key], 'Date'[Month Number], 'Date'[Month] ), 'Date'[Year] = _year ),
			        "@actual", [AC],
			        "@previous", [PY],
			        "@forecast", IF ( 'Date'[Month Number] >= 7, [FC] ),
			        "@delta", IF ( 'Date'[Month Number] >= 7, [ΔFC] )
			    )
			-- Columns stand on y = 640 and are at most 460 px tall
			VAR _max = MAXX ( _months, MAX ( MAX ( [@actual], [@previous] ), [@forecast] ) )
			VAR _scale = DIVIDE ( 460, _max )
			-- Variance strip: zero line between y = 716 and 856
			VAR _up = MAX ( MAXX ( _months, [@delta] ), 0 )
			VAR _down = MAX ( - MINX ( _months, [@delta] ), 0 )
			VAR _zero = 716 + IF ( _up + _down = 0, 70, 140 * _up / ( _up + _down ) )
			VAR _vScale = DIVIDE ( 140, _up + _down )
			VAR _marks =
			    CONCATENATEX (
			        _months,
			        VAR _x = 72 + ( 'Date'[Month Number] - 1 ) * 76
			        VAR _hActual = [@actual] * _scale
			        VAR _hPrevious = [@previous] * _scale
			        VAR _hForecast = [@forecast] * _scale
			        VAR _top = MAX ( MAX ( _hActual, _hPrevious ), _hForecast )
			        VAR _delta = [@delta]
			        VAR _hDelta = ABS ( _delta ) * _vScale
			        RETURN
			            IF ( NOT ISBLANK ( [@previous] ), "<rect x='" & ( _x + 8 ) & "' y='" & FORMAT ( 640 - _hPrevious, "0.0" ) & "' width='30' height='" & FORMAT ( _hPrevious, "0.0" ) & "' fill='%23A6A6A6'/>" )
			            & IF ( NOT ISBLANK ( [@forecast] ), "<rect x='" & FORMAT ( _x + 34.6, "0.0" ) & "' y='" & FORMAT ( 640.6 - _hForecast, "0.0" ) & "' width='28.8' height='" & FORMAT ( MAX ( _hForecast - 1.2, 0 ), "0.0" ) & "' fill='url(%23h)' stroke='%231F1F1F' stroke-width='1.2'/>" )
			            & IF (
			                NOT ISBLANK ( [@actual] ),
			                "<rect x='" & ( _x + 21 ) & "' y='" & FORMAT ( 640 - _hActual, "0.0" ) & "' width='30' height='" & FORMAT ( _hActual, "0.0" ) & "' fill='%231F1F1F'/>"
			                    & "<text x='" & ( _x + 36 ) & "' y='" & FORMAT ( 632 - _top, "0.0" ) & "' class='v' text-anchor='middle'>" & FORMAT ( [@actual] / 1e6, "0.0" ) & "</text>"
			            )
			            & "<text x='" & ( _x + 36 ) & "' y='664' class='k' text-anchor='middle'>" & 'Date'[Month] & "</text>"
			            & IF (
			                ABS ( _delta ) >= 50000,
			                "<rect x='" & ( _x + 21 ) & "' y='" & FORMAT ( IF ( _delta > 0, _zero - _hDelta, _zero ), "0.0" ) & "' width='30' height='" & FORMAT ( _hDelta, "0.0" ) & "' fill='" & IF ( _delta < 0, "%23B83A3A", "%233F8A54" ) & "'/>"
			                    & "<text x='" & ( _x + 36 ) & "' y='" & FORMAT ( IF ( _delta > 0, _zero - _hDelta - 6, _zero + _hDelta + 16 ), "0.0" ) & "' class='v " & IF ( _delta < 0, "r", "g" ) & "' text-anchor='middle'>"
			                    & FORMAT ( ROUND ( _delta / 1e6, 1 ), "+0.0;-0.0;0.0" ) & "</text>"
			            ),
			        "",
			        'Date'[Year Month Key], ASC
			    )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1000' height='924' viewBox='0 0 1000 924'>"
			        & "<style>text{font-family:Segoe UI,sans-serif;fill:%231A1A1A}.t{font-size:16px;font-weight:600}.k{font-size:14px;fill:%236B7280}.b{font-weight:600}"
			        & ".v{font-size:13px;font-weight:600}.s{font-size:12px;fill:%236B7280}.g{fill:%233F8A54}.r{fill:%23B83A3A}</style>"
			        & "<defs><pattern id='h' width='6' height='6' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>"
			        & "<rect width='6' height='6' fill='white'/><line x1='0' y1='0' x2='0' y2='6' stroke='%231F1F1F' stroke-width='2'/></pattern></defs>"
			        & "<text x='20' y='30' class='t'>" & [Headline Subject] & " | USD m | AC and FC 6+6 vs PY | " & _year & " by month</text>"
			        & "<rect x='20' y='50' width='14' height='14' fill='%231F1F1F'/><text x='40' y='62' class='k'>AC</text>"
			        & "<rect x='80.6' y='50.6' width='12.8' height='12.8' fill='url(%23h)' stroke='%231F1F1F' stroke-width='1.2'/><text x='100' y='62' class='k'>FC</text>"
			        & "<rect x='140' y='50' width='14' height='14' fill='%23A6A6A6'/><text x='160' y='62' class='k'>PY</text>"
			        & "<line x1='528' x2='528' y1='84' y2='640' stroke='%239CA3AF' stroke-dasharray='4 4'/>"
			        & "<text x='80' y='100' class='s'>Jan&%238211;Jun: actuals (FC = AC)</text>"
			        & "<text x='540' y='100' class='s'>Jul&%238211;Dec: forecast made in June vs actual</text>"
			        & "<line x1='72' x2='984' y1='640' y2='640' stroke='%239CA3AF'/>"
			        & "<text x='20' y='" & FORMAT ( _zero + 5, "0.0" ) & "' class='k b'>&%23916;FC</text>"
			        & "<line x1='72' x2='984' y1='" & FORMAT ( _zero, "0.0" ) & "' y2='" & FORMAT ( _zero, "0.0" ) & "' stroke='%239CA3AF'/>"
			        & _marks
			        & "<text x='20' y='904' class='s'>&%23916;FC = AC minus the June forecast, Jul&%238211;Dec. Green: actual sales beat the forecast.</text>"
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _max ), "data:image/svg+xml;utf8," & _svg )
		displayFolder: Report visuals
		isHidden
		lineageTag: e58a430b-86d2-470e-bbac-4fb950310f43
		dataCategory: ImageUrl

	/// Report only: SVG chart for the Outlook page, 552 x 220 px: sales vs last year in % for H1 actual, H2 as forecast in June (hatched) and H2 actual. Follows the Channel and Country slicers and clicks.
	measure 'Outlook Pace SVG' =
			VAR _actualH1 = CALCULATE ( [AC], 'Date'[Month Number] <= 6 )
			VAR _previousH1 = CALCULATE ( [PY], 'Date'[Month Number] <= 6 )
			VAR _actualH2 = CALCULATE ( [AC], 'Date'[Month Number] >= 7 )
			VAR _forecastH2 = CALCULATE ( [FC], 'Date'[Month Number] >= 7 )
			VAR _previousH2 = CALCULATE ( [PY], 'Date'[Month Number] >= 7 )
			VAR _rows =
			    {
			        ( 1, "H1 actual", DIVIDE ( _actualH1 - _previousH1, _previousH1 ), 0 ),
			        ( 2, "H2 forecast", DIVIDE ( _forecastH2 - _previousH2, _previousH2 ), 1 ),
			        ( 3, "H2 actual", DIVIDE ( _actualH2 - _previousH2, _previousH2 ), 0 )
			    }
			-- Bars share one scale: 280 px between the largest negative and positive value
			VAR _up = MAX ( MAXX ( _rows, [Value3] ), 0 )
			VAR _down = MAX ( - MINX ( _rows, [Value3] ), 0 )
			VAR _zero = 190 + IF ( _up + _down = 0, 140, 280 * _down / ( _up + _down ) )
			VAR _scale = DIVIDE ( 280, _up + _down )
			VAR _marks =
			    CONCATENATEX (
			        _rows,
			        VAR _y = 52 + ( [Value1] - 1 ) * 50
			        VAR _p = [Value3]
			        VAR _w = MAX ( ABS ( _p ) * _scale, 1 )
			        VAR _color = IF ( _p < 0, "%23B83A3A", "%233F8A54" )
			        -- the forecast bar is hatched in the variance colour
			        VAR _fill = IF ( [Value4] = 1, IF ( _p < 0, "url(%23hr)", "url(%23hg)" ) & "' stroke='" & _color & "' stroke-width='1.2", _color )
			        RETURN
			            "<text x='16' y='" & ( _y + 19 ) & "' class='k'>" & [Value2] & "</text>"
			            & IF (
			                NOT ISBLANK ( _p ),
			                "<rect x='" & FORMAT ( IF ( _p < 0, _zero - _w, _zero ), "0.0" ) & "' y='" & _y & "' width='" & FORMAT ( _w, "0.0" ) & "' height='28' fill='" & _fill & "'/>"
			                    & "<text x='" & FORMAT ( IF ( _p < 0, _zero - _w - 6, _zero + _w + 6 ), "0.0" ) & "' y='" & ( _y + 19 ) & "' class='v " & IF ( _p < 0, "r", "g" ) & "' text-anchor='" & IF ( _p < 0, "end", "start" ) & "'>"
			                    & SUBSTITUTE ( FORMAT ( _p, "+0.0%;-0.0%;0.0%" ), "%", "%25" ) & "</text>"
			            ),
			        "",
			        [Value1], ASC
			    )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='552' height='220' viewBox='0 0 552 220'>"
			        & "<style>text{font-family:Segoe UI,sans-serif;fill:%231A1A1A}.t{font-size:16px;font-weight:600}.k{font-size:14px;fill:%236B7280}"
			        & ".v{font-size:13px;font-weight:600}.g{fill:%233F8A54}.r{fill:%23B83A3A}</style>"
			        & "<defs><pattern id='hr' width='6' height='6' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>"
			        & "<rect width='6' height='6' fill='white'/><line x1='0' y1='0' x2='0' y2='6' stroke='%23B83A3A' stroke-width='2.5'/></pattern>"
			        & "<pattern id='hg' width='6' height='6' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>"
			        & "<rect width='6' height='6' fill='white'/><line x1='0' y1='0' x2='0' y2='6' stroke='%233F8A54' stroke-width='2.5'/></pattern></defs>"
			        & "<text x='16' y='28' class='t'>Sales | &%23916;PY %25 | H1 actual, H2 forecast and actual</text>"
			        & "<line x1='" & FORMAT ( _zero, "0.0" ) & "' x2='" & FORMAT ( _zero, "0.0" ) & "' y1='46' y2='186' stroke='%239CA3AF'/>"
			        & _marks
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _previousH1 ), "data:image/svg+xml;utf8," & _svg )
		displayFolder: Report visuals
		isHidden
		lineageTag: b4344293-912f-4894-b2f8-59b081608085
		dataCategory: ImageUrl

	/// Report only: SVG bridge for the Margin page, 1000 x 924 px: gross margin from PY (grey) to AC (dark) through the volume, product mix, price and unit cost effects (red/green).
	measure 'Margin Bridge SVG' =
			VAR _year = MAX ( 'Date'[Year] )
			VAR _start = [Gross Margin PY]
			VAR _end = [Gross Margin]
			VAR _volume = [Margin Volume Effect]
			VAR _price = [Margin Price Effect]
			VAR _cost = [Margin Unit Cost Effect]
			VAR _mix = ( _end - _start ) - _volume - _price - _cost
			VAR _rateStart = [Gross Margin % PY]
			VAR _rateEnd = [Gross Margin %]
			VAR _level1 = _start + _volume
			VAR _level2 = _level1 + _mix
			VAR _level3 = _level2 + _price
			VAR _steps =
			    {
			        ( 0, "PY", 0, _start ),
			        ( 1, "Volume", _start, _level1 ),
			        ( 2, "Product mix", _level1, _level2 ),
			        ( 3, "Price and discount", _level2, _level3 ),
			        ( 4, "Unit cost", _level3, _end ),
			        ( 5, "AC", 0, _end )
			    }
			-- Columns stand on y = 800 and are at most 600 px tall
			VAR _max = MAXX ( _steps, MAX ( [Value3], [Value4] ) )
			VAR _scale = DIVIDE ( 600, _max )
			VAR _marks =
			    CONCATENATEX (
			        _steps,
			        VAR _i = [Value1]
			        VAR _x = 90 + _i * 150
			        VAR _from = [Value3]
			        VAR _to = [Value4]
			        VAR _change = _to - _from
			        VAR _isTotal = _i = 0 || _i = 5
			        VAR _yTop = 800 - MAX ( _from, _to ) * _scale
			        VAR _h = MAX ( ABS ( _change ) * _scale, 1 )
			        VAR _fill = SWITCH ( _i, 0, "%23A6A6A6", 5, "%231F1F1F", IF ( _change < 0, "%23B83A3A", "%233F8A54" ) )
			        VAR _label = IF ( _isTotal, FORMAT ( _to / 1e6, "0.0" ), FORMAT ( ROUND ( _change / 1e6, 1 ), "+0.0;-0.0;0.0" ) )
			        VAR _labelY = IF ( _isTotal || _change >= 0, _yTop - 8, _yTop + _h + 18 )
			        RETURN
			            "<rect x='" & _x & "' y='" & FORMAT ( _yTop, "0.0" ) & "' width='90' height='" & FORMAT ( _h, "0.0" ) & "' fill='" & _fill & "'/>"
			            & "<text x='" & ( _x + 45 ) & "' y='" & FORMAT ( _labelY, "0.0" ) & "' class='v" & IF ( _isTotal, "", IF ( _change < 0, " r", " g" ) ) & "' text-anchor='middle'>" & _label & "</text>"
			            & "<text x='" & ( _x + 45 ) & "' y='826' class='k' text-anchor='middle'>" & [Value2] & "</text>"
			            & IF (
			                _i < 5,
			                "<line x1='" & ( _x + 90 ) & "' x2='" & ( _x + 150 ) & "' y1='" & FORMAT ( 800 - _to * _scale, "0.0" ) & "' y2='" & FORMAT ( 800 - _to * _scale, "0.0" ) & "' stroke='%239CA3AF' stroke-dasharray='3 3'/>"
			            ),
			        "",
			        [Value1], ASC
			    )
			-- escape only the % of the rates: the arrow entity is already written as %23
			VAR _rateLine =
			    "Margin rate " & SUBSTITUTE ( FORMAT ( _rateStart, "0.0%" ), "%", "%25" ) & " (PY) &%238594; "
			        & SUBSTITUTE ( FORMAT ( _rateEnd, "0.0%" ), "%", "%25" ) & " (AC), "
			        & FORMAT ( ROUND ( ( _rateEnd - _rateStart ) * 100, 1 ), "+0.0;-0.0;0.0" ) & " pp"
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1000' height='924' viewBox='0 0 1000 924'>"
			        & "<style>text{font-family:Segoe UI,sans-serif;fill:%231A1A1A}.t{font-size:16px;font-weight:600}.k{font-size:14px;fill:%236B7280}"
			        & ".v{font-size:14px;font-weight:600}.s{font-size:12px;fill:%236B7280}.g{fill:%233F8A54}.r{fill:%23B83A3A}</style>"
			        & "<text x='20' y='30' class='t'>" & SUBSTITUTE ( SUBSTITUTE ( [Headline Subject], "Sales", "Margin" ), "sales", "margin" ) & " | USD m | PY to AC bridge | " & _year & "</text>"
			        & "<text x='20' y='56' class='k'>" & _rateLine & "</text>"
			        & "<line x1='80' x2='940' y1='800' y2='800' stroke='%239CA3AF'/>"
			        & _marks
			        & "<text x='20' y='876' class='s'>Volume: change in units at last year's margin per unit. Product mix: selling a different mix of products.</text>"
			        & "<text x='20' y='896' class='s'>Price and discount, unit cost: change per unit for products sold in both years.</text>"
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _start ) && NOT ISBLANK ( _end ), "data:image/svg+xml;utf8," & _svg )
		displayFolder: Report visuals
		isHidden
		lineageTag: 7f482900-a398-40ea-8834-f372121f115a
		dataCategory: ImageUrl

	/// Report only: SVG mini chart for the tooltip page, 464 x 236 px: the hovered item's sales by month, AC in front of the chosen comparison (PY grey, BU outlined, FC hatched), with a strip of variance...
	measure 'Tooltip Monthly SVG' =
			VAR _code = [Comparison Label]
			VAR _year = MAX ( 'Date'[Year] )
			VAR _style =
			    SWITCH (
			        _code,
			        "PY", "fill='%23A6A6A6'",
			        "FC", "fill='url(%23h)' stroke='%231F1F1F' stroke-width='1'",
			        "fill='white' stroke='%231F1F1F' stroke-width='1'"
			    )
			VAR _months =
			    ADDCOLUMNS (
			        CALCULATETABLE ( SUMMARIZE ( 'Date', 'Date'[Year Month Key], 'Date'[Month Number], 'Date'[Month] ), 'Date'[Year] = _year ),
			        "@actual", [AC],
			        "@comparison", [CMP],
			        "@delta", [ΔCMP]
			    )
			-- Columns stand on y = 150 and are at most 116 px tall; variance strip between y = 178 and 222
			VAR _max = MAXX ( _months, MAX ( [@actual], [@comparison] ) )
			VAR _scale = DIVIDE ( 116, _max )
			VAR _up = MAX ( MAXX ( _months, [@delta] ), 0 )
			VAR _down = MAX ( - MINX ( _months, [@delta] ), 0 )
			VAR _zero = 178 + IF ( _up + _down = 0, 22, 44 * _up / ( _up + _down ) )
			VAR _vScale = DIVIDE ( 44, _up + _down )
			VAR _marks =
			    CONCATENATEX (
			        _months,
			        VAR _x = 40 + ( 'Date'[Month Number] - 1 ) * 35
			        VAR _hActual = [@actual] * _scale
			        VAR _hComparison = [@comparison] * _scale
			        VAR _delta = [@delta]
			        VAR _hDelta = MAX ( ABS ( _delta ) * _vScale, 1 )
			        RETURN
			            IF ( NOT ISBLANK ( [@comparison] ), "<rect x='" & FORMAT ( _x + 12.5, "0.0" ) & "' y='" & FORMAT ( 150.5 - _hComparison, "0.0" ) & "' width='15' height='" & FORMAT ( MAX ( _hComparison - 1, 0 ), "0.0" ) & "' " & _style & "/>" )
			            & IF ( NOT ISBLANK ( [@actual] ), "<rect x='" & ( _x + 4 ) & "' y='" & FORMAT ( 150 - _hActual, "0.0" ) & "' width='16' height='" & FORMAT ( _hActual, "0.0" ) & "' fill='%231F1F1F'/>" )
			            & "<text x='" & ( _x + 14 ) & "' y='166' class='s' text-anchor='middle'>" & LEFT ( 'Date'[Month], 1 ) & "</text>"
			            & IF (
			                NOT ISBLANK ( _delta ),
			                "<rect x='" & ( _x + 4 ) & "' y='" & FORMAT ( IF ( _delta > 0, _zero - _hDelta, _zero ), "0.0" ) & "' width='16' height='" & FORMAT ( _hDelta, "0.0" ) & "' fill='" & IF ( _delta < 0, "%23B83A3A", "%233F8A54" ) & "'/>"
			            ),
			        "",
			        'Date'[Year Month Key], ASC
			    )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='464' height='236' viewBox='0 0 464 236'>"
			        & "<style>text{font-family:Segoe UI,sans-serif;fill:%231A1A1A}.s{font-size:11px;fill:%236B7280}.b{font-weight:600}</style>"
			        & "<defs><pattern id='h' width='4' height='4' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>"
			        & "<rect width='4' height='4' fill='white'/><line x1='0' y1='0' x2='0' y2='4' stroke='%231F1F1F' stroke-width='1.4'/></pattern></defs>"
			        & "<rect x='40' y='6' width='10' height='10' fill='%231F1F1F'/><text x='54' y='15' class='s'>AC</text>"
			        & "<rect x='80.5' y='6.5' width='9' height='9' " & _style & "/><text x='94' y='15' class='s'>" & _code & "</text>"
			        & "<text x='130' y='15' class='s'>by month, USD</text>"
			        & "<line x1='36' x2='460' y1='150' y2='150' stroke='%239CA3AF'/>"
			        & "<text x='2' y='" & FORMAT ( _zero + 4, "0.0" ) & "' class='s b'>&%23916;" & _code & "</text>"
			        & "<line x1='36' x2='460' y1='" & FORMAT ( _zero, "0.0" ) & "' y2='" & FORMAT ( _zero, "0.0" ) & "' stroke='%239CA3AF'/>"
			        & _marks
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _max ), "data:image/svg+xml;utf8," & _svg )
		displayFolder: Report visuals
		isHidden
		lineageTag: e95897c2-ec8a-4c24-9a29-3722c9fb9684
		dataCategory: ImageUrl

	/// Report only: SVG legend for the navy sidebar, 248 x 176 px: the IBCS notation used in the report (AC solid, FC hatched, BU outlined, PY grey, variances green/red). Static.
	measure 'IBCS Legend SVG' =
			"data:image/svg+xml;utf8,"
			    & "<svg xmlns='http://www.w3.org/2000/svg' width='248' height='176' viewBox='0 0 248 176'>"
			    & "<style>text{font-family:Segoe UI,sans-serif;font-size:13px;fill:%23E5E7EB}.c{font-size:11px;letter-spacing:1px;font-weight:600;fill:%239AA6C4}</style>"
			    & "<defs><pattern id='h' width='5' height='5' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>"
			    & "<line x1='0' y1='0' x2='0' y2='5' stroke='white' stroke-width='1.6'/></pattern></defs>"
			    & "<text x='8' y='16' class='c'>IBCS NOTATION</text>"
			    & "<rect x='8' y='32' width='22' height='12' fill='white'/><text x='40' y='43'>AC  Actual</text>"
			    & "<rect x='8.5' y='56.5' width='21' height='11' fill='url(%23h)' stroke='white'/><text x='40' y='67'>FC  Forecast</text>"
			    & "<rect x='8.5' y='80.5' width='21' height='11' fill='none' stroke='white'/><text x='40' y='91'>BU  Budget</text>"
			    & "<rect x='8' y='104' width='22' height='12' fill='%23A6A6A6'/><text x='40' y='115'>PY  Previous year</text>"
			    & "<rect x='8' y='128' width='10' height='12' fill='%233F8A54'/><rect x='20' y='128' width='10' height='12' fill='%23B83A3A'/>"
			    & "<text x='40' y='139'>&%23916;  Variance +/&%238722;</text>"
			    & "</svg>"
		displayFolder: Report visuals
		isHidden
		lineageTag: 9ab48ee4-c540-43f4-bcc8-3a44e233f3fa
		dataCategory: ImageUrl

