/// Sales transactions (actuals, AC) in USD by day, store and product, 2016-05-18 to 2025-12-31. Use its measures: Net Sales (revenue), Cost (COGS), Gross Margin, Sales Quantity.
table Sales
	lineageTag: e41b475d-f1a4-4d80-a104-7c11d35ecfa9

	/// Revenue (sales, turnover) in USD after discounts: quantity x net price. Higher is better. For PY, BU or FC use the PY, BU, FC measures or the Scenario group.
	measure 'Net Sales' = SUM ( 'Sales'[Net Sales Amount] )
		formatString: \$#,##0
		displayFolder: Sales
		lineageTag: bd67c0ba-17a2-4343-8ef4-43adebdd4202

	/// Units sold (volume). Higher is better. PY via the PY scenario; there is no unit budget or forecast, so BU and FC are blank.
	measure 'Sales Quantity' = SUM ( 'Sales'[Quantity] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: f795bad9-711d-4d0b-a932-f7f761895a44

	/// COGS (cost of goods sold) in USD: quantity x unit cost. Lower is better for margin. PY via the PY scenario; no cost budget or forecast (BU, FC blank).
	measure Cost = SUM ( 'Sales'[Cost Amount] )
		formatString: \$#,##0
		displayFolder: Margin
		lineageTag: 78557194-9198-4930-9797-640b3fec8c8e

	/// Gross profit in USD: revenue (Net Sales) minus COGS (Cost). Higher is better. PY via the PY scenario; no margin budget or forecast (BU, FC blank).
	measure 'Gross Margin' = [Net Sales] - [Cost]
		formatString: \$#,##0
		displayFolder: Margin
		lineageTag: 717029a4-3acd-4747-939e-ac3e4f62846d

	/// Gross margin rate: gross profit / revenue. Higher is better; compare years in pp with Gross Margin % ΔPY pp. No margin budget or forecast.
	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Net Sales] )
		formatString: 0.0%
		displayFolder: Margin
		lineageTag: 29bc4af4-bd2a-4b1e-9f20-ffd3820a3381

	/// Actual revenue in USD, the same as Net Sales. Use it next to PY, BU and FC. Higher is better.
	measure AC = CALCULATE ( [Net Sales], 'Scenario'[Scenario] = "AC" )
		formatString: \$#,##0
		displayFolder: Scenario measures
		lineageTag: 4352f791-30c9-4b69-8bd1-0e0534a589fb

	/// Previous-year revenue in USD: Net Sales of the same period one year earlier. Works at any grain.
	measure PY = CALCULATE ( [Net Sales], 'Scenario'[Scenario] = "PY" )
		formatString: \$#,##0
		displayFolder: Scenario measures
		lineageTag: d207066c-667b-4957-8ec7-309eda4fa6df

	/// Budget revenue in USD, 2025 only, by month x category x country; blank below that grain (store, brand, day). No budget for cost, margin or units.
	measure BU = CALCULATE ( [Net Sales], 'Scenario'[Scenario] = "BU" )
		formatString: \$#,##0
		displayFolder: Scenario measures
		lineageTag: 5b3af94c-4be3-40f7-a424-d93a2ab51c67

	/// Forecast 6+6 revenue in USD for 2025: Jan-Jun actuals plus the Jul-Dec forecast made in June. Month x category x country grain; blank below it.
	measure FC = CALCULATE ( [Net Sales], 'Scenario'[Scenario] = "FC" )
		formatString: \$#,##0
		displayFolder: Scenario measures
		lineageTag: 7a22e9a5-c750-4041-be07-14f5dd555a76

	/// Revenue change vs last year in USD: AC - PY. Positive = growth (good).
	measure ΔPY = CALCULATE ( [Net Sales], 'Scenario'[Scenario] = "ΔPY" )
		formatString: +\$#,##0;-\$#,##0;\$0
		displayFolder: Scenario measures
		lineageTag: 9ddf70dd-fff7-413d-9eb3-cd846aa28fa3

	/// Revenue growth vs last year in %: (AC - PY) / PY. Positive is good.
	measure 'ΔPY %' = CALCULATE ( [Net Sales], 'Scenario'[Scenario] = "ΔPY%" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Scenario measures
		lineageTag: 69bcdb85-66b2-48c2-8ca0-db4afc64a0c1

	/// Revenue gap to budget in USD: AC - BU. Negative = below budget (bad). 2025 only, by month x category x country.
	measure ΔBU = CALCULATE ( [Net Sales], 'Scenario'[Scenario] = "ΔBU" )
		formatString: +\$#,##0;-\$#,##0;\$0
		displayFolder: Scenario measures
		lineageTag: 5b3dc48a-d151-4e19-9941-a4fa138c07d1

	/// Revenue vs budget in %: (AC - BU) / BU. Negative = below budget (bad). 2025 only, by month x category x country.
	measure 'ΔBU %' = CALCULATE ( [Net Sales], 'Scenario'[Scenario] = "ΔBU%" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Scenario measures
		lineageTag: 50159283-67a5-4d4a-94cf-031a4cfa87f1

	/// Revenue vs forecast in USD: AC - FC. Positive = beat the forecast (good). Zero Jan-Jun 2025, where the forecast equals actuals.
	measure ΔFC = CALCULATE ( [Net Sales], 'Scenario'[Scenario] = "ΔFC" )
		formatString: +\$#,##0;-\$#,##0;\$0
		displayFolder: Scenario measures
		lineageTag: 9126bb77-bf6e-4f56-a844-c359f1fe2c0e

	/// Revenue vs forecast in %: (AC - FC) / FC. Positive = beat the forecast (good). 2025 only.
	measure 'ΔFC %' = CALCULATE ( [Net Sales], 'Scenario'[Scenario] = "ΔFC%" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Scenario measures
		lineageTag: a5efa88d-e59f-4c2a-b961-b8b15420e301

	/// Average selling price (ASP) per unit in USD: revenue / units. List prices did not change in 2025, so changes mostly reflect product mix.
	measure 'Avg Net Price' = DIVIDE ( [Net Sales], [Sales Quantity] )
		formatString: \$#,##0.00
		displayFolder: Sales
		lineageTag: 32a39f5e-07d8-439a-a390-f7a5b153e112

	/// Average cost (COGS) per unit sold in USD: Cost / units. Lower is better for margin.
	measure 'Avg Unit Cost' = DIVIDE ( [Cost], [Sales Quantity] )
		formatString: \$#,##0.00
		displayFolder: Margin
		lineageTag: a0fb9633-d195-4ba2-96da-5a280e480117

	/// Unit (volume) growth vs last year in %. Positive is good. Compared with PY because the plan has no units.
	measure 'Units ΔPY %' = CALCULATE ( [Sales Quantity], 'Scenario'[Scenario] = "ΔPY%" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Drivers vs PY
		lineageTag: a9d71987-c279-4a6e-b0d9-ada3ad4e62af

	/// Change in average selling price per unit vs last year, in %. Reflects product mix and discounts; list prices per product did not change in 2025.
	measure 'Avg Net Price ΔPY %' = CALCULATE ( [Avg Net Price], 'Scenario'[Scenario] = "ΔPY%" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Drivers vs PY
		lineageTag: bbdb6981-81a6-40cf-810b-947234ca3065

	/// Change in average cost per unit vs last year, in %. A rise is bad for margin.
	measure 'Avg Unit Cost ΔPY %' = CALCULATE ( [Avg Unit Cost], 'Scenario'[Scenario] = "ΔPY%" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Drivers vs PY
		lineageTag: d1403a0a-62b9-4200-9d2f-ad5d8ded3e08

	/// Last year's gross profit in USD: Gross Margin of the same period one year earlier.
	measure 'Gross Margin PY' = CALCULATE ( [Gross Margin], 'Scenario'[Scenario] = "PY" )
		formatString: \$#,##0
		displayFolder: Margin
		lineageTag: ad6c64f8-143b-4a0e-8e4d-d773d7428764

	/// Gross profit change vs last year in USD. Positive is good. Equals the sum of the four margin bridge effects.
	measure 'Gross Margin ΔPY' = CALCULATE ( [Gross Margin], 'Scenario'[Scenario] = "ΔPY" )
		formatString: +\$#,##0;-\$#,##0;\$0
		displayFolder: Margin
		lineageTag: 728b7c22-c466-4367-bd10-fd6dd455150e

	/// Gross profit growth vs last year in %. Positive is good.
	measure 'Gross Margin ΔPY %' = CALCULATE ( [Gross Margin], 'Scenario'[Scenario] = "ΔPY%" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Margin
		lineageTag: 72c26ba9-2808-4282-8f25-e01e7d37ed9d

	/// Last year's gross margin rate, same period one year earlier.
	measure 'Gross Margin % PY' = CALCULATE ( [Gross Margin %], 'Scenario'[Scenario] = "PY" )
		formatString: 0.0%
		displayFolder: Margin
		lineageTag: 0b0e4609-fb80-448b-9839-b4ae9171457a

	/// Report only: Gross margin rate in the last month with sales in the selected period, blank in the other months. Labels the end of the AC line in the margin rate chart.
	measure 'Gross Margin % Last Month' =
			VAR _month = SELECTEDVALUE ( 'Date'[Month Number] )
			VAR _last =
			    CALCULATE (
			        MAXX ( FILTER ( VALUES ( 'Date'[Month Number] ), NOT ISBLANK ( [Gross Margin %] ) ), 'Date'[Month Number] ),
			        ALLSELECTED ( 'Date' )
			    )
			RETURN
			    IF ( _month = _last, [Gross Margin %] )
		formatString: 0.0%
		displayFolder: Margin
		isHidden
		lineageTag: 8e229230-6d59-4b01-a31c-ab750fc182e9

	/// Report only: Gross margin rate of the same period last year in the last month with sales in the selected period, blank in the other months. Labels the end of the PY line in the margin rate chart.
	measure 'Gross Margin % PY Last Month' =
			VAR _month = SELECTEDVALUE ( 'Date'[Month Number] )
			VAR _last =
			    CALCULATE (
			        MAXX ( FILTER ( VALUES ( 'Date'[Month Number] ), NOT ISBLANK ( [Gross Margin %] ) ), 'Date'[Month Number] ),
			        ALLSELECTED ( 'Date' )
			    )
			RETURN
			    IF ( _month = _last, [Gross Margin % PY] )
		formatString: 0.0%
		displayFolder: Margin
		isHidden
		lineageTag: ac9b6356-b1dc-4a13-8f31-c58b6f7519f2

	/// Margin rate change vs last year in percentage points (pp). Positive is good; changes that round to 0.0 pp show as 0.
	measure 'Gross Margin % ΔPY pp' =
			VAR _actual = [Gross Margin %]
			VAR _previousYear = [Gross Margin % PY]
			VAR _pp = ( _actual - _previousYear ) * 100
			RETURN
			    IF ( NOT ISBLANK ( _actual ) && NOT ISBLANK ( _previousYear ), IF ( ROUND ( _pp, 1 ) = 0, 0, _pp ) )
		formatString: +0.0 \p\p;-0.0 \p\p;0.0 \p\p
		displayFolder: Margin
		lineageTag: 109322d1-2464-45a0-a530-49c3f2074d6a

	/// Margin bridge PY to AC: gross profit change from units sold, valued at last year's margin per unit, USD. Positive is good.
	measure 'Margin Volume Effect' =
			VAR _units = [Sales Quantity]
			VAR _unitsPY = CALCULATE ( [Sales Quantity], 'Scenario'[Scenario] = "PY" )
			VAR _marginPY = [Gross Margin PY]
			RETURN
			    -- divide as double: a currency divided by units is rounded to 4 decimals before it is multiplied back up
			    IF ( _unitsPY > 0, ROUND ( ( _units - _unitsPY ) * DIVIDE ( CONVERT ( _marginPY, DOUBLE ), _unitsPY ), 2 ) )
		formatString: +\$#,##0;-\$#,##0;\$0
		displayFolder: Margin bridge
		lineageTag: 2b66fb6d-9751-4a28-aa87-840a07368bde

	/// Margin bridge PY to AC: gross profit change from net price per unit (list price, discount), products sold in both years, USD. Positive is good.
	measure 'Margin Price Effect' =
			VAR _products =
			    ADDCOLUMNS (
			        VALUES ( 'Product'[Product Key] ),
			        "@units", [Sales Quantity],
			        "@sales", [Net Sales],
			        "@unitsPY", CALCULATE ( [Sales Quantity], 'Scenario'[Scenario] = "PY" ),
			        "@salesPY", CALCULATE ( [Net Sales], 'Scenario'[Scenario] = "PY" )
			    )
			VAR _effect =
			    SUMX (
			        FILTER ( _products, [@units] > 0 && [@unitsPY] > 0 ),
			        [@sales] - [@units] * DIVIDE ( CONVERT ( [@salesPY], DOUBLE ), [@unitsPY] )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _effect ), ROUND ( _effect, 2 ) )
		formatString: +\$#,##0;-\$#,##0;\$0
		displayFolder: Margin bridge
		lineageTag: dc491a19-af8c-426a-973c-69f20cea6b83

	/// Margin bridge PY to AC: gross profit change from cost per unit, products sold in both years, USD. Negative = costs rose (bad).
	measure 'Margin Unit Cost Effect' =
			VAR _products =
			    ADDCOLUMNS (
			        VALUES ( 'Product'[Product Key] ),
			        "@units", [Sales Quantity],
			        "@cost", [Cost],
			        "@unitsPY", CALCULATE ( [Sales Quantity], 'Scenario'[Scenario] = "PY" ),
			        "@costPY", CALCULATE ( [Cost], 'Scenario'[Scenario] = "PY" )
			    )
			VAR _costIncrease =
			    SUMX (
			        FILTER ( _products, [@units] > 0 && [@unitsPY] > 0 ),
			        [@cost] - [@units] * DIVIDE ( CONVERT ( [@costPY], DOUBLE ), [@unitsPY] )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _costIncrease ), - ROUND ( _costIncrease, 2 ) )
		formatString: +\$#,##0;-\$#,##0;\$0
		displayFolder: Margin bridge
		lineageTag: bb858fc6-191d-41c0-a057-9eebfcbf97b5

	/// Margin bridge PY to AC: gross profit change from a different product mix, incl. new or dropped products, USD. Positive is good.
	measure 'Margin Mix Effect' =
			VAR _change = [Gross Margin ΔPY]
			RETURN
			    IF ( NOT ISBLANK ( _change ), _change - [Margin Volume Effect] - [Margin Price Effect] - [Margin Unit Cost Effect] )
		formatString: +\$#,##0;-\$#,##0;\$0
		displayFolder: Margin bridge
		lineageTag: 0e82ec44-b25b-4766-a56f-5905da23ec15

	/// Report only: Comparison chosen in the report's Compare with slicer: PY, BU or FC. BU when nothing or more than one is selected. Text, used by the comparison measures, headlines and dynamic titles.
	measure 'Comparison Label' = SELECTEDVALUE ( 'Comparison'[Comparison], "BU" )
		displayFolder: Report titles
		isHidden
		lineageTag: da588170-5a71-4375-a61a-4e831e14fd93

	/// Report only: The Compare with choice in words for headlines: budget, forecast or last year.
	measure 'Comparison Name' = SWITCH ( [Comparison Label], "BU", "budget", "FC", "forecast", "last year" )
		displayFolder: Report titles
		isHidden
		lineageTag: 9d6648ef-b3e0-4f02-b4bb-4723d0fb10f8

	/// Report only: Net sales of the comparison chosen in the Compare with slicer: PY, BU or FC (BU by default). Same values as the PY, BU and FC measures.
	measure CMP = SWITCH ( [Comparison Label], "BU", [BU], "FC", [FC], [PY] )
		formatString: \$#,##0
		displayFolder: Comparison
		isHidden
		lineageTag: 0d22ef29-29df-4c9b-815e-8b390ff11229

	/// Report only: AC minus the comparison chosen in the Compare with slicer: ΔPY, ΔBU or ΔFC (ΔBU by default).
	measure ΔCMP = SWITCH ( [Comparison Label], "BU", [ΔBU], "FC", [ΔFC], [ΔPY] )
		formatString: +\$#,##0;-\$#,##0;\$0
		displayFolder: Comparison
		isHidden
		lineageTag: 107fd6f5-2396-4251-a2e6-09342695ff85

	/// Report only: AC vs the comparison chosen in the Compare with slicer, in %: ΔPY %, ΔBU % or ΔFC % (ΔBU % by default).
	measure 'ΔCMP %' = SWITCH ( [Comparison Label], "BU", [ΔBU %], "FC", [ΔFC %], [ΔPY %] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comparison
		isHidden
		lineageTag: b4a78004-15bf-41fc-b630-3aeb5829ec94

	/// Report only: Second comparison shown beside the Compare with choice: PY when BU or FC is chosen, BU when PY is chosen. Text.
	measure 'CMP2 Label' = IF ( [Comparison Label] = "PY", "BU", "PY" )
		displayFolder: Report titles
		isHidden
		lineageTag: 41501c55-6148-465d-b235-382bdc4fecbc

	/// Report only: The second comparison in words for headlines: budget or last year.
	measure 'CMP2 Name' = IF ( [CMP2 Label] = "BU", "budget", "last year" )
		displayFolder: Report titles
		isHidden
		lineageTag: 8582e7f4-427e-423e-b9a9-54f7bc326a77

	/// Report only: Net sales of the second comparison: PY, or BU when PY is chosen in the Compare with slicer.
	measure CMP2 = IF ( [CMP2 Label] = "BU", [BU], [PY] )
		formatString: \$#,##0
		displayFolder: Comparison
		isHidden
		lineageTag: 48649c5a-5d5a-4997-a338-2ea7082ce54c

	/// Report only: AC minus the second comparison: ΔPY, or ΔBU when PY is chosen in the Compare with slicer.
	measure ΔCMP2 = IF ( [CMP2 Label] = "BU", [ΔBU], [ΔPY] )
		formatString: +\$#,##0;-\$#,##0;\$0
		displayFolder: Comparison
		isHidden
		lineageTag: 81c47cb6-2a2a-45e7-9a6a-5a1dc0732b09

	/// Report only: AC vs the second comparison, in %: ΔPY %, or ΔBU % when PY is chosen in the Compare with slicer.
	measure 'ΔCMP2 %' = IF ( [CMP2 Label] = "BU", [ΔBU %], [ΔPY %] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comparison
		isHidden
		lineageTag: acee5da7-e97f-48f7-8846-3eda205a4b37

	/// Report only: Channel the Channels page focuses on: the single channel in the filter context (slicer or click), otherwise the channel that contributes most to the total variance vs the chosen...
	measure 'Focus Channel' =
			VAR _selected = SELECTEDVALUE ( 'Store'[Channel] )
			VAR _channels =
			    ADDCOLUMNS (
			        VALUES ( 'Store'[Channel] ),
			        "@delta", CALCULATE ( [ΔCMP], ALLSELECTED ( 'Product' ) )
			    )
			VAR _sign = IF ( SUMX ( _channels, [@delta] ) < 0, -1, 1 )
			RETURN
			    IF (
			        NOT ISBLANK ( _selected ),
			        _selected,
			        MAXX ( TOPN ( 1, _channels, [@delta] * _sign, DESC ), 'Store'[Channel] )
			    )
		displayFolder: Report text
		isHidden
		lineageTag: 0603e39c-b515-41ee-981f-738ad831fdc9

	/// Report only: ΔCMP for the focus channel of the Channels page (the clicked or selected channel, otherwise the one that contributes most to the variance).
	measure 'ΔCMP Focus Channel' =
			VAR _channel = [Focus Channel]
			RETURN
			    CALCULATE ( [ΔCMP], 'Store'[Channel] = _channel )
		formatString: +\$#,##0;-\$#,##0;\$0
		displayFolder: Comparison
		isHidden
		lineageTag: d968cd3c-c95c-4957-9d0e-2725f1fdea2b

	/// Report only: Subject for headlines and chart titles from the active filters: Sales, Online sales, Store sales, Sales in Germany, Computers sales in the United States. Text.
	measure 'Headline Subject' =
			VAR _category = IF ( ISFILTERED ( 'Product'[Category] ), SELECTEDVALUE ( 'Product'[Category] ) )
			VAR _country = IF ( ISFILTERED ( 'Store'[Country] ), SELECTEDVALUE ( 'Store'[Country] ) )
			VAR _channel = IF ( ISFILTERED ( 'Store'[Channel] ), SELECTEDVALUE ( 'Store'[Channel] ) )
			VAR _countryName = IF ( _country IN { "United States", "United Kingdom", "Netherlands" }, "the " & _country, _country )
			VAR _where =
			    SWITCH (
			        TRUE (),
			        _country = "Online" || ( ISBLANK ( _country ) && _channel = "Online" ), " online",
			        NOT ISBLANK ( _country ), " in " & _countryName,
			        _channel = "Stores", " in stores",
			        ""
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _category ), _category & " sales" & _where,
			        _where = " online", "Online sales",
			        _where = " in stores", "Store sales",
			        "Sales" & _where
			    )
		displayFolder: Report text
		isHidden
		lineageTag: 75cf4f10-9fed-4668-bcbe-f3c955f8c4d5

	/// Report only: Overview page headline: AC vs the chosen comparison and the second comparison, and the channel (or, with one channel, the category) that carries most of the gap.
	measure 'Headline Overview' =
			VAR _subject = [Headline Subject]
			VAR _delta = [ΔCMP]
			VAR _pct = [ΔCMP %]
			VAR _pct2 = [ΔCMP2 %]
			VAR _byChannel = NOT HASONEVALUE ( 'Store'[Channel] )
			VAR _items =
			    UNION (
			        FILTER ( SELECTCOLUMNS ( VALUES ( 'Store'[Channel] ), "@name", 'Store'[Channel], "@delta", [ΔCMP] ), _byChannel ),
			        FILTER ( SELECTCOLUMNS ( VALUES ( 'Product'[Category] ), "@name", 'Product'[Category], "@delta", [ΔCMP] ), NOT _byChannel )
			    )
			VAR _sign = IF ( _delta < 0, -1, 1 )
			VAR _top = TOPN ( 1, FILTER ( _items, [@delta] * _sign > 0 ), [@delta] * _sign, DESC )
			VAR _topName = MAXX ( _top, [@name] )
			VAR _topDelta = MAXX ( _top, [@delta] )
			VAR _share = DIVIDE ( _topDelta, _delta )
			VAR _gapWord = IF ( _delta < 0, "gap", "lead" )
			VAR _total = "$" & FORMAT ( ABS ( _delta ) / 1e6, "0.0" ) & "M"
			VAR _vs1 = FORMAT ( ABS ( _pct ), "0.0%" ) & IF ( _pct < 0, " below ", " above " ) & [Comparison Name]
			VAR _vs2 =
			    IF (
			        NOT ISBLANK ( _pct2 ),
			        IF ( ( _pct < 0 ) = ( _pct2 < 0 ), " and ", " but " )
			            & FORMAT ( ABS ( _pct2 ), "0.0%" ) & IF ( _pct2 < 0, " below ", " above " ) & [CMP2 Name]
			    )
			-- Channels read as "Online sales" / "Store sales" (plural), categories as "the Computers category" (singular)
			VAR _topLabel = IF ( _byChannel, IF ( _topName = "Stores", "Store", _topName ) & " sales", "the " & _topName & " category" )
			VAR _driver =
			    IF (
			        COUNTROWS ( _items ) > 1 && NOT ISBLANK ( _topName ),
			        "; " & _topLabel
			            & IF (
			                _share > 1,
			                IF ( _byChannel, " are $", " is $" ) & FORMAT ( ABS ( _topDelta ) / 1e6, "0.0" ) & "M" & IF ( _topDelta < 0, " below ", " above " ) & [Comparison Name]
			                    & ", more than the whole " & _total & " " & _gapWord,
			                IF ( _byChannel, " carry ", " carries " ) & FORMAT ( _share, "0%" ) & " of the " & _total & " " & _gapWord
			            )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _delta ), _subject & " are " & _vs1 & _vs2 & _driver )
		displayFolder: Report text
		isHidden
		lineageTag: 39918caa-b7d2-4f7f-83f1-6faaf777cbd8

	/// Report only: Channels page headline: the focus channel's share of the gap to the chosen comparison and its change vs the second comparison.
	measure 'Headline Channels' =
			VAR _channel = [Focus Channel]
			VAR _plural = _channel = "Stores"
			VAR _delta = CALCULATE ( [ΔCMP], REMOVEFILTERS ( 'Store'[Channel] ) )
			VAR _channels = CALCULATE ( DISTINCTCOUNT ( 'Store'[Channel] ), REMOVEFILTERS ( 'Store'[Channel] ) )
			VAR _channelDelta = CALCULATE ( [ΔCMP], 'Store'[Channel] = _channel )
			VAR _channelPct = CALCULATE ( [ΔCMP %], 'Store'[Channel] = _channel )
			VAR _channelPct2 = CALCULATE ( [ΔCMP2 %], 'Store'[Channel] = _channel )
			VAR _share = DIVIDE ( _channelDelta, _delta )
			VAR _verb = IF ( _plural, " are ", " is " )
			VAR _money = "$" & FORMAT ( ABS ( _channelDelta ) / 1e6, "0.0" ) & "M"
			VAR _total = "$" & FORMAT ( ABS ( _delta ) / 1e6, "0.0" ) & "M"
			VAR _dir = IF ( _channelDelta < 0, " below ", " above " )
			VAR _vs2 =
			    IF (
			        NOT ISBLANK ( _channelPct2 ),
			        FORMAT ( ABS ( _channelPct2 ), "0.0%" ) & IF ( _channelPct2 < 0, " below ", " above " ) & [CMP2 Name]
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _channelDelta ),
			        SWITCH (
			            TRUE (),
			            _channels = 1,
			                _channel & _verb & _money & " (" & FORMAT ( ABS ( _channelPct ), "0.0%" ) & ")" & _dir & [Comparison Name]
			                    & IF ( NOT ISBLANK ( _vs2 ), " and " & _vs2 ),
			            _share > 1,
			                _channel & _verb & _money & _dir & [Comparison Name] & ", more than the whole " & _total & IF ( _delta < 0, " gap", " lead" )
			                    & IF ( NOT ISBLANK ( _vs2 ), ", and " & _vs2 ),
			            _share <= 0,
			                _channel & _verb & _money & _dir & [Comparison Name] & " while the total is " & _total & IF ( _delta < 0, " below", " above" )
			                    & IF ( NOT ISBLANK ( _vs2 ), "; " & IF ( _plural, "they are ", "it is " ) & _vs2 ),
			            _channel & IF ( _plural, " account for ", " accounts for " ) & FORMAT ( _share, "0%" ) & " of the " & _total
			                & IF ( _delta < 0, " gap to ", " lead over " ) & [Comparison Name]
			                & IF ( NOT ISBLANK ( _vs2 ), " and" & _verb & _vs2 )
			        )
			    )
		displayFolder: Report text
		isHidden
		lineageTag: 8d66ec9d-462e-42d5-80d4-336fa8ce8e87

	/// Report only: Products page headline: the category that carries most of the gap to the chosen comparison, and its units vs last year (the plan has no units).
	measure 'Headline Products' =
			VAR _delta = [ΔCMP]
			VAR _items = SELECTCOLUMNS ( VALUES ( 'Product'[Category] ), "@name", 'Product'[Category], "@delta", [ΔCMP] )
			VAR _sign = IF ( _delta < 0, -1, 1 )
			VAR _top = TOPN ( 1, FILTER ( _items, [@delta] * _sign > 0 ), [@delta] * _sign, DESC )
			VAR _name = MAXX ( _top, [@name] )
			VAR _topDelta = MAXX ( _top, [@delta] )
			VAR _share = DIVIDE ( _topDelta, _delta )
			VAR _units = CALCULATE ( [Units ΔPY %], 'Product'[Category] = _name )
			VAR _price = CALCULATE ( [Avg Net Price ΔPY %], 'Product'[Category] = _name )
			VAR _unitsText = "units are " & FORMAT ( ABS ( _units ), "0.0%" ) & IF ( _units < 0, " below", " above" ) & " last year"
			VAR _money = "$" & FORMAT ( ABS ( _topDelta ) / 1e6, "0.0" ) & "M"
			VAR _total = "$" & FORMAT ( ABS ( _delta ) / 1e6, "0.0" ) & "M"
			RETURN
			    IF (
			        NOT ISBLANK ( _name ),
			        SWITCH (
			            TRUE (),
			            COUNTROWS ( _items ) = 1,
			                _name & ": " & _money & " (" & FORMAT ( ABS ( [ΔCMP %] ), "0.0%" ) & ")" & IF ( _delta < 0, " below ", " above " ) & [Comparison Name]
			                    & "; " & _unitsText & " and the average price is " & FORMAT ( ABS ( _price ), "0.0%" ) & IF ( _price < 0, " lower", " higher" ),
			            _share > 1,
			                _name & ": " & _money & IF ( _topDelta < 0, " below ", " above " ) & [Comparison Name] & ", more than the whole " & _total
			                    & IF ( _delta < 0, " gap", " lead" ) & "; " & _unitsText,
			            _money & " of the " & _total & IF ( _delta < 0, " gap to ", " lead over " ) & [Comparison Name] & " comes from " & _name & ", where " & _unitsText
			        )
			    )
		displayFolder: Report text
		isHidden
		lineageTag: 3c775ef4-52dd-4bf8-9391-1a0b53d9cfce

	/// Report only: Regions page headline: the one or two countries that carry most of the gap to the chosen comparison, and the net variance of the others.
	measure 'Headline Regions' =
			VAR _delta = [ΔCMP]
			VAR _items = SELECTCOLUMNS ( VALUES ( 'Store'[Country] ), "@name", 'Store'[Country], "@delta", [ΔCMP] )
			VAR _sign = IF ( _delta < 0, -1, 1 )
			VAR _top = TOPN ( 2, FILTER ( _items, [@delta] * _sign > 0 ), [@delta] * _sign, DESC )
			VAR _topCount = COUNTROWS ( _top )
			VAR _first = MAXX ( TOPN ( 1, _top, [@delta] * _sign, DESC ), [@name] )
			VAR _second = MAXX ( TOPN ( 1, _top, [@delta] * _sign, ASC ), [@name] )
			VAR _topDelta = SUMX ( _top, [@delta] )
			VAR _others = COUNTROWS ( _items ) - _topCount
			VAR _otherDelta = _delta - _topDelta
			VAR _articles = { "United States", "United Kingdom", "Netherlands" }
			VAR _firstName = IF ( _first IN _articles, "The " & _first, _first )
			VAR _secondName = IF ( _second IN _articles, "the " & _second, _second )
			VAR _dir = IF ( _delta < 0, " below ", " above " )
			VAR _pct2 = [ΔCMP2 %]
			VAR _rest =
			    SWITCH (
			        TRUE (),
			        _others = 1, "; the other country is $" & FORMAT ( ABS ( _otherDelta ) / 1e6, "0.0" ) & "M" & IF ( _otherDelta < 0, " behind", " ahead" ),
			        _others > 1, "; the other " & _others & " are $" & FORMAT ( ABS ( _otherDelta ) / 1e6, "0.0" ) & "M" & IF ( _otherDelta < 0, " behind", " ahead" ),
			        ""
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _first ),
			        SWITCH (
			            TRUE (),
			            COUNTROWS ( _items ) = 1,
			                _firstName & " is $" & FORMAT ( ABS ( _delta ) / 1e6, "0.0" ) & "M (" & FORMAT ( ABS ( [ΔCMP %] ), "0.0%" ) & ")" & _dir & [Comparison Name]
			                    & IF ( NOT ISBLANK ( _pct2 ), " and " & FORMAT ( ABS ( _pct2 ), "0.0%" ) & IF ( _pct2 < 0, " below ", " above " ) & [CMP2 Name] ),
			            _topCount = 2,
			                _firstName & " and " & _secondName & " are $" & FORMAT ( ABS ( _topDelta ) / 1e6, "0.0" ) & "M" & _dir & [Comparison Name] & _rest,
			            _firstName & " is $" & FORMAT ( ABS ( _topDelta ) / 1e6, "0.0" ) & "M" & _dir & [Comparison Name] & _rest
			        )
			    )
		displayFolder: Report text
		isHidden
		lineageTag: be1b72f1-f547-4acd-b0ef-099fc4882005

	/// Report only: Margin page headline: gross margin vs last year and the bridge effects that explain it (there is no margin budget, so the page always compares with PY and says so when BU or FC is...
	measure 'Headline Margin' =
			VAR _subject = SUBSTITUTE ( SUBSTITUTE ( [Headline Subject], "Sales", "Margin" ), "sales", "margin" )
			VAR _change = [Gross Margin ΔPY]
			VAR _rate = [Gross Margin %]
			VAR _ratePP = [Gross Margin % ΔPY pp]
			VAR _volume = [Margin Volume Effect]
			VAR _price = [Margin Price Effect]
			VAR _cost = [Margin Unit Cost Effect]
			VAR _mix = _change - _volume - _price - _cost
			VAR _effects =
			    {
			        ( 1, "product mix", _mix, "product mix" ),
			        ( 2, IF ( _volume < 0, "lower volume", "higher volume" ), _volume, "volume" ),
			        ( 3, IF ( _price < 0, "lower prices", "higher prices" ), _price, "prices" ),
			        ( 4, IF ( _cost < 0, "higher unit costs", "lower unit costs" ), _cost, "unit costs" )
			    }
			-- Effects under 5% of the change (at least $50k) count as unchanged
			VAR _threshold = MAX ( ABS ( _change ) * 0.05, 50000 )
			VAR _big = FILTER ( _effects, ABS ( [Value3] ) >= _threshold )
			VAR _small = FILTER ( _effects, ABS ( [Value3] ) < _threshold )
			VAR _drivers =
			    CONCATENATEX (
			        _big,
			        [Value2] & IF ( [Value3] < 0, " cost $", " added $" ) & FORMAT ( ABS ( [Value3] ) / 1e6, "0.0" ) & "M",
			        IF ( COUNTROWS ( _big ) <= 2, " and ", ", " ),
			        ABS ( [Value3] ), DESC
			    )
			VAR _held = IF ( COUNTROWS ( _small ) > 0, ", while " & CONCATENATEX ( _small, [Value4], " and ", [Value1], ASC ) & " held" )
			VAR _rateText =
			    IF (
			        ROUND ( _ratePP, 1 ) = 0,
			        "; the rate held at ",
			        "; the rate " & IF ( _ratePP < 0, "fell ", "rose " ) & FORMAT ( ABS ( _ratePP ), "0.0" ) & " pp to "
			    ) & FORMAT ( _rate, "0.0%" )
			VAR _amount = "$" & FORMAT ( ABS ( _change ) / 1e6, "0.0" ) & "M"
			VAR _lowerSubject = IF ( LEFT ( _subject, 6 ) = "Margin", "margin" & MID ( _subject, 7, 200 ), _subject )
			RETURN
			    IF (
			        NOT ISBLANK ( _change ),
			        IF (
			            [Comparison Label] = "PY",
			            _subject & " is " & _amount & IF ( _change < 0, " below", " above" ) & " last year: " & _drivers & _held & _rateText,
			            "No margin budget; compared with last year, " & _lowerSubject & " is " & _amount & IF ( _change < 0, " lower: ", " higher: " ) & _drivers & _held
			        )
			    )
		displayFolder: Report text
		isHidden
		lineageTag: c2d27b94-144d-402b-92ec-fdff9ef976f6

	/// Report only: Outlook page headline: what the June forecast (6+6) expected for H2 vs last year, what H2 delivered, and how the year closed vs the chosen comparison.
	measure 'Headline Outlook' =
			VAR _actualH2 = CALCULATE ( [AC], 'Date'[Month Number] >= 7 )
			VAR _forecastH2 = CALCULATE ( [FC], 'Date'[Month Number] >= 7 )
			VAR _previousH2 = CALCULATE ( [PY], 'Date'[Month Number] >= 7 )
			VAR _forecastVsPY = DIVIDE ( _forecastH2 - _previousH2, _previousH2 )
			VAR _actualVsPY = DIVIDE ( _actualH2 - _previousH2, _previousH2 )
			VAR _beat = _actualH2 - _forecastH2
			VAR _pct = [ΔCMP %]
			VAR _subject = [Headline Subject]
			VAR _prefix = IF ( _subject = "Sales", "The June forecast", _subject & ": the June forecast" )
			RETURN
			    IF (
			        NOT ISBLANK ( _forecastH2 ) && NOT ISBLANK ( _actualH2 ),
			        _prefix & " expected H2 " & FORMAT ( ABS ( _forecastVsPY ), "0.0%" ) & IF ( _forecastVsPY < 0, " below", " above" ) & " last year; H2 closed "
			            & FORMAT ( ABS ( _actualVsPY ), "0.0%" ) & IF ( _actualVsPY < 0, " below", " above" )
			            & ", $" & FORMAT ( ABS ( _beat ) / 1e6, "0.0" ) & "M" & IF ( _beat >= 0, " better", " worse" )
			            & ", and the year " & FORMAT ( ABS ( _pct ), "0.0%" ) & IF ( _pct < 0, " below ", " above " ) & [Comparison Name]
			    )
		displayFolder: Report text
		isHidden
		lineageTag: dbc84f79-73c6-4364-819b-e1258ec41364

	/// Report only: Grey line under each page headline: period, currency, scenario key and the active Channel, Country and Category filters. Text.
	measure Subtitle =
			VAR _year = MAX ( 'Date'[Year] )
			VAR _channel = IF ( ISFILTERED ( 'Store'[Channel] ), "Channel: " & CONCATENATEX ( VALUES ( 'Store'[Channel] ), 'Store'[Channel], ", ", 'Store'[Channel], ASC ) )
			VAR _country = IF ( ISFILTERED ( 'Store'[Country] ), "Country: " & CONCATENATEX ( VALUES ( 'Store'[Country] ), 'Store'[Country], ", ", 'Store'[Country], ASC ) )
			VAR _category = IF ( ISFILTERED ( 'Product'[Category] ), "Category: " & CONCATENATEX ( VALUES ( 'Product'[Category] ), 'Product'[Category], ", ", 'Product'[Category], ASC ) )
			VAR _scope = CONCATENATEX ( FILTER ( { _channel, _country, _category }, [Value] <> "" ), [Value], " · " )
			RETURN
			    "Full year " & _year & " · USD · AC actual, PY " & ( _year - 1 ) & ", BU Budget " & _year & ", FC Forecast 6+6 · "
			        & IF ( _scope = "", "All channels and countries", _scope )
		displayFolder: Report text
		isHidden
		lineageTag: e151b197-5c4e-414e-aee4-2a74236d7fdc

	/// Report only: Subtitle for the Products page: the standard subtitle plus a note that units, price and cost compare with PY. Text.
	measure 'Subtitle Products' = [Subtitle] & " · Units, price and cost vs PY (the plan has no units)"
		displayFolder: Report text
		isHidden
		lineageTag: c2b9c187-4641-46a1-ac77-c275cf118223

	/// Report only: Subtitle for the Margin page: the standard subtitle plus a note that margin compares with PY. Text.
	measure 'Subtitle Margin' = [Subtitle] & " · Margin vs PY (no margin budget)"
		displayFolder: Report text
		isHidden
		lineageTag: 5c7b40ab-f83b-48fe-a190-bc6f543eea74

	/// Report only: Subtitle for the Outlook page: the standard subtitle plus what FC 6+6 means. Text.
	measure 'Subtitle Outlook' = [Subtitle] & " · FC 6+6: Jan–Jun actuals, Jul–Dec forecast made in June"
		displayFolder: Report text
		isHidden
		lineageTag: 7b5cc389-28c8-4d9b-bcc0-e5bc03bff8b0

	/// Report only: Name of the hovered item on the tooltip page: category, country or channel. Text.
	measure 'Tooltip Title' =
			VAR _category = IF ( ISFILTERED ( 'Product'[Category] ), SELECTEDVALUE ( 'Product'[Category] ) )
			VAR _country = IF ( ISFILTERED ( 'Store'[Country] ), SELECTEDVALUE ( 'Store'[Country] ) )
			VAR _channel = IF ( ISFILTERED ( 'Store'[Channel] ), SELECTEDVALUE ( 'Store'[Channel] ) )
			RETURN
			    COALESCE ( _category, _country, _channel, "All sales" )
		displayFolder: Report text
		isHidden
		lineageTag: e8001704-8d09-4d5b-9b24-8273ad30eb19

	/// Report only: One-line summary on the tooltip page: AC and the variance vs the chosen comparison, e.g. AC $106.0M · ΔBU −$18.4M (−14.8%) · 2025. Text.
	measure 'Tooltip Summary' =
			VAR _year = MAX ( 'Date'[Year] )
			VAR _actual = [AC]
			VAR _delta = [ΔCMP]
			VAR _pct = [ΔCMP %]
			RETURN
			    IF (
			        NOT ISBLANK ( _actual ),
			        "AC $" & FORMAT ( _actual / 1e6, "0.0" ) & "M · Δ" & [Comparison Label] & " "
			            & IF ( ISBLANK ( _delta ), "n/a", FORMAT ( _delta / 1e6, "+\$0.0;-\$0.0;\$0.0" ) & "M (" & FORMAT ( _pct, "+0.0%;-0.0%;0.0%" ) & ")" )
			            & " · " & _year
			    )
		displayFolder: Report text
		isHidden
		lineageTag: 2bf95ef7-2524-4b72-ab47-61a186b71866

	/// Report only: Text for a dynamic report title that follows the Compare with slicer: the variance code, e.g. ΔBU.
	measure 'Title KPI Δ' = "Δ" & [Comparison Label]
		displayFolder: Report titles
